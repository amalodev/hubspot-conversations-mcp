# Authentication is per-user OAuth: run `npx -y hubspot-conversations-mcp login`.
# Your org's broker URL (used by `login`/`setup` when --broker-url is not passed)
HUBSPOT_OAUTH_BROKER_URL=

# Optional: default sender actor used by SendConversationMessage when
# sender_actor_id is not passed. Agent actors look like "A-<hubspot user id>".
HUBSPOT_DEFAULT_SENDER_ACTOR_ID=

# Optional overrides (defaults shown)
# HUBSPOT_BASE_URL=https://api.hubapi.com
# HUBSPOT_CONVERSATIONS_API_VERSION=2026-09-beta
# HUBSPOT_CUSTOM_CHANNELS_API_VERSION=2026-03
# HUBSPOT_TOKEN_STORE_PATH=~/.hubspot-conversations-mcp/tokens.json

# Broker deployment only (set on the Vercel project, never on user machines):
# HUBSPOT_OAUTH_CLIENT_ID=
# HUBSPOT_OAUTH_CLIENT_SECRET=
