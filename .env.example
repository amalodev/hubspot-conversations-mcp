# Required: HubSpot service key (Development → Keys → Service Keys) with the
# conversations.read and conversations.write scopes. Legacy private app tokens
# and OAuth2 access tokens with the same scopes also work.
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: default sender actor used by SendConversationMessage when
# sender_actor_id is not passed. Agent actors look like "A-<hubspot user id>".
HUBSPOT_DEFAULT_SENDER_ACTOR_ID=

# Optional overrides (defaults shown)
# HUBSPOT_BASE_URL=https://api.hubapi.com
# HUBSPOT_CONVERSATIONS_API_VERSION=2026-09-beta
# HUBSPOT_CUSTOM_CHANNELS_API_VERSION=2026-03
# HUBSPOT_AUTH_MODE=bearer   # or "private-app" for the legacy header
