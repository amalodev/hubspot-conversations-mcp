# Required: HubSpot private app access token (scopes: conversations.read, conversations.write)
# or an OAuth2 access token with the same scopes.
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: default sender actor used by send_message when senderActorId is not passed.
# Agent actors look like "A-<hubspot user id>".
HUBSPOT_DEFAULT_SENDER_ACTOR_ID=

# Optional overrides (defaults shown)
# HUBSPOT_BASE_URL=https://api.hubapi.com
# HUBSPOT_CONVERSATIONS_API_VERSION=2026-09-beta
# HUBSPOT_AUTH_MODE=private-app   # or "bearer"; auto-detected from the token prefix when unset
